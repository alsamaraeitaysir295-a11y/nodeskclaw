{
  // OpenClaw 配置模板
  // 由 docker-entrypoint.sh 通过 envsubst 替换 ${} 占位符后生成 openclaw.json
  // 完整 schema: src/config/zod-schema.ts (OpenClawSchema)

  "gateway": {
    "port": ${OPENCLAW_GATEWAY_PORT},
    "bind": "${OPENCLAW_GATEWAY_BIND}",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000
      }
    },
    "controlUi": {
      "enabled": true,
      "dangerouslyAllowHostHeaderOriginFallback": true,
      "dangerouslyDisableDeviceAuth": true
    }
  },

  // NoDeskClaw 赛博办公室 channel 不在这里声明：channels.nodeskclaw 需要与
  // plugins.entries.nodeskclaw（插件注册 + 文件部署）同时就位才是合法配置，
  // 二者都由 deploy_nodeskclaw_channel_plugin() 在实例绑定工作空间时一次性写入
  // openclaw.json（见 llm_config_service.py _inject_channel_config）。这里如果
  // 提前写一个空账号占位符，OpenClaw 2026.6.11+ 会在插件就位前直接拒绝启动
  // （channels.nodeskclaw: unknown channel id），旧版本能容忍但本质上也只是
  // 无效占位符，未绑定工作空间前 tunnel-client 一样连不上。

  "tools": {
    "exec": {
      "security": "full",
      "ask": "off"
    }
  },

  "logging": {
    "level": "${OPENCLAW_LOG_LEVEL}"
  }
}
